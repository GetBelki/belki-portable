{
  "name": "belki-portable",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://getbelki.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/GetBelki/belki-portable.git"
  },
  "bugs": {
    "url": "https://github.com/GetBelki/belki-portable/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "tsx watch src/portable/server.ts",
    "dev:client": "vite",
    "build": "pnpm build:client && pnpm build:server",
    "build:client": "vite build",
    "build:server": "tsup src/portable/server.ts src/portable/worker.ts src/portable/migrate.ts src/portable/admin.ts --format esm --target node22 --out-dir dist/server --sourcemap --clean",
    "start": "node dist/server/server.js",
    "start:worker": "node dist/server/worker.js",
    "migrate": "node dist/server/migrate.js",
    "admin": "node dist/server/admin.js",
    "preview": "pnpm build && pnpm start",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.portable.json && tsc -p tsconfig.node.json && tsc -p tsconfig.test.json && tsc -p tsconfig.integration.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "benchmark:entities": "node scripts/entity-extraction-benchmark.mjs",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm lint --max-warnings 0 && pnpm test && pnpm build",
    "db:migrate": "tsx src/portable/migrate.ts",
    "sync:check": "node scripts/check-upstream-sync.mjs",
    "sync:check:record": "node scripts/check-portable-sync-record.mjs",
    "sync:apply": "node scripts/check-upstream-sync.mjs --apply"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1117.0",
    "@base-ui/react": "1.7.0",
    "@hono/node-server": "2.1.1",
    "@hono/zod-validator": "0.9.0",
    "@js-temporal/polyfill": "0.5.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@tanstack/react-query": "5.102.3",
    "@tanstack/react-table": "9.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "graphile-worker": "0.17.3",
    "hono": "4.13.4",
    "lucide-react": "1.34.0",
    "node-pg-migrate": "9.0.0",
    "nodemailer": "9.0.5",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.2",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0",
    "tldts": "7.4.11",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260825.1",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.3.0",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "concurrently": "10.0.5",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
