# Required core services
DATABASE_URL=postgresql://belki:change-me@postgres:5432/belki
DATABASE_SSL_MODE=disable
APP_BASE_URL=http://localhost:8080
APP_CRYPTO_KEY=generate-an-independent-value-with-at-least-32-characters
BOOTSTRAP_TOKEN=generate-an-independent-value-with-at-least-32-characters

# S3-compatible evidence storage. Credentials may be omitted for workload identity.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=belki-evidence
S3_ACCESS_KEY_ID=belki
S3_SECRET_ACCESS_KEY=change-me
S3_FORCE_PATH_STYLE=true

# DataForSEO capture provider
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_WEBHOOK_TOKEN=

# Optional OpenAI-compatible structured inference
INFERENCE_MODE=disabled
INFERENCE_BASE_URL=https://api.openai.com/v1
INFERENCE_API_KEY=
INFERENCE_MODEL=

# Optional SMTP delivery
EMAIL_MODE=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Belki

# Managed billing and operator identity
DEPLOYMENT_MODE=self_hosted
PAYMENT_MODE=disabled
STRIPE_ENVIRONMENT=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
OIDC_TRUST_SECRET=
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_COOKIE_SECRET=

# Runtime tuning
TRUST_PROXY_HEADERS=false
DATABASE_POOL_MAX=20
WORKER_CONCURRENCY=10
BELKI_HTTP_PORT=8080
